# Public browser-safe Supabase values. Configure these in Vercel too.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Legacy projects may use VITE_SUPABASE_ANON_KEY instead.
# Never expose SUPABASE_SERVICE_ROLE_KEY or other server secrets in VITE_* variables.
